    {
      "question": "What is shadow puppetry?",
      "status": 200,
      "elapsed_ms": 1284.0617060000004,
      "answer": {
        "answer_id": "ans_89807bd6ef5e4dba9f98cc676f3ef0c8",
        "locale": "en",
        "depth": "beginner",
        "status": "answered",
        "uncertainty": "insufficient",
        "reason": "general_explanation",
        "answer_text": "Shadow puppetry is a traditional form of storytelling where flat figures are held behind a lit screen, so the audience sees their moving shadows. Think of making animal shapes with your hands on a wall lit by a lamp — shadow puppetry works in a similar way, but with carefully cut figures and a story. Performers move the puppets and often speak or sing the characters' parts, bringing a tale to life through light and shadow.",
