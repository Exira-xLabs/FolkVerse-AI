    {
      "question": "What is shadow puppetry?",
      "status": 200,
      "elapsed_ms": 1351.018959,
      "answer": {
        "answer_id": "ans_10936eaea5d946af9bbd1a6dc1c91968",
        "locale": "en",
        "depth": "beginner",
        "status": "answered",
        "uncertainty": "insufficient",
        "reason": "general_explanation",
        "answer_text": "Shadow puppetry is a traditional form of storytelling where flat figures are held behind a lit screen, casting shadows that move and act out a tale. Think of it like an early cartoon: the puppeteer controls the characters from behind, and the audience sees only the shadows. Have you ever made hand shadows on a wall? That is the same basic idea, but with carefully cut figures and a scripted story.",
