# Copying this file alone does not configure the app. Run pnpm setup:local.
# Local environment names; real values and credentials must remain untracked.
APP_MODE=
DATABASE_URL=
SESSION_SECRET=
COOKIE_SECURE=
ALLOWED_ORIGINS=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=
# Next.js server-only upstream address (written to apps/web/.env.local).
API_BASE_URL=
# Phase 03: verify current provider docs and pricing before enabling calls.
GUIDE_PROVIDER=deepseek
# Ollama Cloud uses its own key and public model identifier, not a DeepSeek-issued key.
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com/v1
OLLAMA_MODEL=deepseek-v4.1-flash
# Zero disables Ollama generation. Set a bounded positive account request cap for live mode.
OLLAMA_DAILY_REQUEST_LIMIT=0
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=
GLM_ENABLED=
VOICE_MODE=
ASR_API_KEY=
TTS_API_KEY=
MEDIA_STORAGE=
MEDIA_ROOT=
RAW_MEDIA_TTL_HOURS=
MAX_UPLOAD_MB=
MAX_IMAGE_PIXELS=
MAX_AUDIO_SECONDS=
MODEL_MAX_OUTPUT_TOKENS=
MODEL_TIMEOUT_SECONDS=
MODEL_MAX_CONCURRENCY=
DAILY_AI_BUDGET_USD=
# Phase 03 admission defaults: 24,000 input tokens, 800 output tokens, 30s,
# two concurrent attempts, six attempts/session/minute, thirty globally/minute.
MODEL_MAX_INPUT_TOKENS=
MODEL_RATE_LIMIT_PER_MINUTE=
MODEL_GLOBAL_RATE_LIMIT_PER_MINUTE=
# Bind reviewed peak/cache-miss USD rates to the exact model and normalized base URL.
# Missing rates, mismatched bindings, or a zero (default) daily budget disable calls.
DEEPSEEK_PRICE_MODEL=
DEEPSEEK_PRICE_BASE_URL=
DEEPSEEK_INPUT_USD_PER_MILLION=
DEEPSEEK_OUTPUT_USD_PER_MILLION=

# Local semantic retrieval is opt-in after an offline build and measured CPU benchmark.
EMBEDDING_ENABLED=false
EMBEDDING_MODEL_DIR=.local/models/bge-m3
EMBEDDING_INDEX_PATH=.local/retrieval/bge-m3.json
EMBEDDING_QUERY_TIMEOUT_SECONDS=15
EMBEDDING_MIN_COSINE=0.3
