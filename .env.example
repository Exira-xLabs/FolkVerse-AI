# Environment reference: WORKING / OPTIONAL / NOT IMPLEMENTED labels below.
# Run pnpm setup:local first; it creates ignored .env and apps/web/.env.local
# with generated database credentials and a session secret. Then edit those files.
# Do not replace the generated .env with this reference or commit real credentials.
# Restart the API and web processes after changing their settings.

# WORKING: real chat, personality, bilingual replies and consented conversation context.
# APP_MODE=live sends messages to the API; demo is a scripted preview, not live AI.
# setup:local starts in demo mode. Change the generated root .env to live.
# An APP_MODE override in the web process takes precedence over the root .env.
APP_MODE=live

# WORKING: PostgreSQL and signed sessions. Keep the values generated by setup:local.
# DATABASE_URL must use postgresql+psycopg://; SESSION_SECRET needs >=32 characters.
DATABASE_URL=
SESSION_SECRET=
POSTGRES_USER=folkverse
POSTGRES_PASSWORD=
POSTGRES_DB=folkverse
POSTGRES_PORT=5440
SESSION_TTL_SECONDS=86400
COOKIE_SECURE=false
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
# Public HTTPS hosting: set COOKIE_SECURE=true and add the exact public HTTPS
# origin to ALLOWED_ORIGINS. See docs/setup.md for the web proxy configuration.

# WORKING / LIVE-TESTED: DeepSeek text generation. Configure only in root .env.
# The implemented DeepSeek adapter accepts deepseek-flash or deepseek-v4-pro.
# deepseek-flash is the model used for the real-model checks.
GUIDE_PROVIDER=deepseek
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# Uncomment and fill privately; do not use a NEXT_PUBLIC_ variable for any key.
# DEEPSEEK_API_KEY=

# WORKING: bounded model admission. Zero budget deliberately disables paid calls.
# Live DeepSeek needs a key, a positive authorized budget, and positive reviewed
# USD/million-token rates bound to the exact model and normalized base URL.
# Fill rates from the provider's current pricing; no guessed prices in this file.
DAILY_AI_BUDGET_USD=0
DEEPSEEK_PRICE_MODEL=deepseek-flash
DEEPSEEK_PRICE_BASE_URL=https://api.deepseek.com
# DEEPSEEK_INPUT_USD_PER_MILLION=
# DEEPSEEK_OUTPUT_USD_PER_MILLION=
MODEL_MAX_INPUT_TOKENS=24000
MODEL_MAX_OUTPUT_TOKENS=800
MODEL_TIMEOUT_SECONDS=30
MODEL_MAX_CONCURRENCY=2
MODEL_RATE_LIMIT_PER_MINUTE=6
MODEL_GLOBAL_RATE_LIMIT_PER_MINUTE=30

# WORKING: reviewed local knowledge plus lookup through configured trusted sources.
# This does not mean unrestricted web search or complete coverage of every fact.
TRUSTED_LOOKUP_ENABLED=true

# OPTIONAL / IMPLEMENTED, NOT LIVE-TESTED HERE: Ollama Cloud provider.
# Select GUIDE_PROVIDER=ollama, provide an Ollama key and authorize a positive
# account request cap. A DeepSeek-issued key cannot authenticate to Ollama.
# This adapter supports the official cloud endpoint, not a local Ollama daemon.
# Confirm this model is available to your Ollama account before switching.
# OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com/v1
OLLAMA_MODEL=deepseek-v4.1-flash
OLLAMA_DAILY_REQUEST_LIMIT=0

# OPTIONAL / BENCHMARKED: local semantic retrieval; disabled by default.
# Enabling requires downloaded model files and a built compatible index.
# Reviewed lexical retrieval remains available with embeddings disabled.
EMBEDDING_ENABLED=false
EMBEDDING_MODEL_DIR=.local/models/bge-m3
EMBEDDING_INDEX_PATH=.local/retrieval/bge-m3.json
EMBEDDING_QUERY_TIMEOUT_SECONDS=15
EMBEDDING_MIN_COSINE=0.3

# WORKING: web server settings belong in apps/web/.env.local or the web process,
# not only root .env. These commented examples are not API settings.
# API_BASE_URL=http://127.0.0.1:8000
# PUBLIC_APP_ORIGIN=https://your-public-host.example
# PUBLIC_APP_ORIGIN is needed for HTTPS hosting through an HTTP upstream proxy.
# Use an exact origin without a path; omit it for ordinary localhost use.

# NOT IMPLEMENTED: GLM generation, voice, uploads and media processing.
# These names are future placeholders; setting them does not enable a feature.
GLM_ENABLED=false
# VOICE_MODE=
# ASR_API_KEY=
# TTS_API_KEY=
# MEDIA_STORAGE=
# MEDIA_ROOT=
# RAW_MEDIA_TTL_HOURS=
# MAX_UPLOAD_MB=
# MAX_IMAGE_PIXELS=
# MAX_AUDIO_SECONDS=
