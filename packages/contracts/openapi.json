{
  "components": {
    "schemas": {
      "ErrorDetail": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "retryable": {
            "title": "Retryable",
            "type": "boolean"
          }
        },
        "required": [
          "code",
          "message",
          "retryable"
        ],
        "title": "ErrorDetail",
        "type": "object"
      },
      "ErrorEnvelope": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          }
        },
        "required": [
          "error",
          "request_id"
        ],
        "title": "ErrorEnvelope",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "database": {
            "enum": [
              "available",
              "unavailable"
            ],
            "title": "Database",
            "type": "string"
          },
          "mode": {
            "enum": [
              "demo",
              "live"
            ],
            "title": "Mode",
            "type": "string"
          },
          "pgvector": {
            "enum": [
              "available",
              "unavailable"
            ],
            "title": "Pgvector",
            "type": "string"
          },
          "pgvector_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pgvector Version"
          },
          "postgres_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Postgres Version"
          },
          "schema_status": {
            "enum": [
              "current",
              "unavailable"
            ],
            "title": "Schema Status",
            "type": "string"
          },
          "status": {
            "enum": [
              "ok",
              "degraded"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "mode",
          "database",
          "pgvector",
          "schema_status"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "SessionDeleted": {
        "properties": {
          "deleted": {
            "const": true,
            "default": true,
            "title": "Deleted",
            "type": "boolean"
          }
        },
        "title": "SessionDeleted",
        "type": "object"
      },
      "SessionResponse": {
        "properties": {
          "behavioral_opt_in": {
            "const": false,
            "default": false,
            "title": "Behavioral Opt In",
            "type": "boolean"
          },
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          },
          "session_id": {
            "title": "Session Id",
            "type": "string"
          }
        },
        "required": [
          "session_id",
          "expires_at"
        ],
        "title": "SessionResponse",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "FolkVerse API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/health": {
      "get": {
        "operationId": "health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/HealthResponse"
                    },
                    {
                      "$ref": "#/components/schemas/ErrorEnvelope"
                    }
                  ],
                  "title": "Response 503 Health"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Health"
      }
    },
